{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.mjs",
    "packages/db/prisma/schema.prisma"
  ],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    // Prisma's client is generated into the shared pnpm store, which is a single directory
    // three tasks used to write concurrently — `build`, `typecheck` and `test` each ran
    // `prisma generate` themselves, and turbo runs them in parallel. That raced: a task
    // importing @prisma/client while another generate was mid-write fails with
    // "Cannot find module '.prisma/client/default'". Generation is now one task that the
    // other three depend on, so it happens exactly once per invocation.
    //
    // Not cached: the output lives outside the workspace where turbo cannot restore it, so
    // a cache hit would mean "skip generation" on a machine that has no client at all.
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["DATABASE_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"],
      "env": ["DATABASE_URL"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build", "generate"],
      "env": ["TEST_DATABASE_URL", "DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
