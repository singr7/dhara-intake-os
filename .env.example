# Dhara Intake OS — environment template (S01)
# Copy to .env for `docker compose up`. Every var here is Zod-validated at boot by
# packages/contracts/src/env.ts — a missing/invalid value crashes the process at start,
# never silently at call time (demo lesson, doc 04 §3).

NODE_ENV=development
APP_BASE_URL=http://localhost:8088

# Postgres
POSTGRES_USER=dhara
POSTGRES_PASSWORD=dhara_dev_password
POSTGRES_DB=dhara
DATABASE_URL=postgresql://dhara:dhara_dev_password@postgres:5432/dhara?schema=public

# Redis
REDIS_URL=redis://redis:6379

# S3 / MinIO
S3_ENDPOINT=http://minio:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=dhara_minio
S3_SECRET_ACCESS_KEY=dhara_minio_dev_password
S3_BUCKET_AUDIO=audio
S3_BUCKET_DOCUMENTS=documents
S3_BUCKET_EXPORTS=exports

# Auth — 32+ chars. Generate: openssl rand -hex 32
SESSION_SECRET=change_me_change_me_change_me_change_me
# Staff console session lifetime; a clinic shift is the unit that matters.
SESSION_TTL_HOURS=12
# Failed logins allowed per IP per minute before 429 (doc 09 §4).
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Seed users' password (packages/db `pnpm db:seed`). Development only — the seed script
# refuses to run with NODE_ENV=production.
SEED_PASSWORD=dhara-dev-password

# Host-side published ports. Deliberately off the common defaults so the stack can run
# alongside other projects on the same machine. Container-internal ports never change.
EDGE_HOST_PORT=8088
API_HOST_PORT=3011
POSTGRES_HOST_PORT=5442
REDIS_HOST_PORT=6389
MINIO_HOST_PORT=9010
MINIO_CONSOLE_HOST_PORT=9011
